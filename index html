<!DOCTYPE html><html><head><meta name="viewport" content="width=device-width, initial-scale=1"><title>COOLGUY BAN CHECKER</title>
<style>body{background:#0b1622;color:#fff;font-family:sans-serif;padding:16px} .card{background:#16263a;padding:18px;border-radius:16px;margin-top:14px} input{width:92%;padding:14px;border-radius:12px;border:none;font-size:17px;background:#0b1622;color:#fff} button{width:100%;padding:14px;border:none;border-radius:12px;font-size:17px;font-weight:bold;color:#fff;background:#e11d48} .blue{background:#2563eb} .green{color:#22c55e} .red{color:#ef4444}</style>
</head><body>
<div style="display:flex;justify-content:space-between"><b>🐺 COOLGUY BAN CHECKER</b><span>CHECKER</span></div>
<div class="card"><small>🌐 WHATSAPP BAN ANALYSIS</small><h2>Hello, <span id="uname">MURUNGI DAVID</span>!</h2><p>Enter an international number to view verified status and available details.</p></div>
<div class="card"><h3>📞 Check a Number</h3><p>Phone Number</p><input id="phone" placeholder="+256..." value="+256"><p style="font-size:12px;opacity:.7">Enter full international number, including + and country code. Spaces, brackets, dots and hyphens are automatically removed.</p><button onclick="check()">🔍 Check a Number</button><p id="msg"></p><div id="result"></div></div>
<p style="text-align:center;font-size:11px;opacity:.6">🐺 COOLGUY BAN CHECKER | WhatsApp Account Status<br>Only verified checker results are shown.</p>
<script>
async function check(){
  let num=document.getElementById('phone').value;
  document.getElementById('msg').innerText='Checking...';
  let btn=document.querySelector('button'); btn.innerText='Checking...';
  try{
    let res=await fetch('https://YOUR-RAILWAY-URL/api/status',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({number:num})});
    let d=await res.json();
    if(!d.success){ document.getElementById('result').innerHTML=`<h3>❌ Check failed</h3><p>${d.message}</p><button class="blue" onclick="location.reload()">Check another number</button>`; btn.innerText='Check a Number'; return; }
    let color=d.banned?'🔴':'🟢';
    let big=d.banned?'BANNED':'Not banned';
    document.getElementById('result').innerHTML=`<div><small>BAN STATUS - ${d.date}</small><h2>${color} ${big}</h2><p>Ban Status: ${big}</p><p>Phone Number: ${d.phoneNumber}</p><p>Phone Country: ${d.phoneCountryFlag} ${d.phoneCountry}</p><hr><table width="100%"><tr><td>Field</td><td>Value</td></tr><tr><td>Phone Number</td><td>${d.phoneNumber}</td></tr><tr><td>Phone Country</td><td>${d.phoneCountryFlag} ${d.phoneCountry}</td></tr><tr><td>Ban Status</td><td>${d.banStatus}</td></tr><tr><td>WhatsApp Account Status</td><td>${d.whatsappStatus}</td></tr><tr><td>Official WhatsApp</td><td>${d.officialWhatsapp}</td></tr></table><br><button class="blue" onclick="location.reload()">Check another number</button></div>`;
  }catch(e){ document.getElementById('result').innerHTML='<h3>❌ Check failed</h3>'; }
  btn.innerText='Check a Number'; document.getElementById('msg').innerText='';
}
if(window.Telegram?.WebApp){ document.getElementById('uname').innerText=Telegram.WebApp.initDataUnsafe?.user?.first_name?.toUpperCase()||'MURUNGI DAVID'; }
</script></body></html>
